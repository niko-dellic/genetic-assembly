{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "real"
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "baseline": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "lower",
        "upper",
        "baseline"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "integer"
        },
        "lower": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "upper": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "step": {
          "default": 1,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "baseline": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "lower",
        "upper",
        "step",
        "baseline"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "boolean"
        },
        "baseline": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "baseline"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "categorical"
        },
        "choices": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baseline": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "choices",
        "baseline"
      ],
      "additionalProperties": false
    }
  ]
}
