{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "candidateId": {
      "type": "string"
    },
    "decisions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "number",
          "boolean",
          "string"
        ]
      }
    },
    "metrics": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "constraints": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "seedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "feasible": {
      "type": "boolean"
    }
  },
  "required": [
    "candidateId",
    "decisions",
    "metrics",
    "constraints",
    "seedCount",
    "feasible"
  ],
  "additionalProperties": false
}
