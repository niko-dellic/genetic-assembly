{
  "name": "genetic-assembly",
  "version": "0.2.0",
  "private": true,
  "description": "Native Rust NSGA-II local optimization companion",
  "type": "module",
  "scripts": {
    "setup": "npm --prefix headless-client ci && npm --prefix adapter-sdk ci && npm --prefix cli ci && npm --prefix examples/reference-adapter ci && npm --prefix client ci && npm --prefix visualizations ci && npm --prefix demo ci",
    "up": "node scripts/up.mjs",
    "up:backend": "docker compose up -d --build --wait postgres server",
    "down": "docker compose down",
    "status": "docker compose ps",
    "logs": "docker compose logs -f server postgres",
    "build": "cargo build --workspace && npm run headless:build && npm run adapter-sdk:build && npm run cli:build && npm run reference:build && npm run client:build && npm run viz:build && npm run demo:build",
    "test": "cargo test --workspace && npm run headless:type-check && npm run adapter-sdk:test && npm run cli:build && npm run reference:test && npm run client:type-check && npm run viz:type-check && npm run viz:test && npm run demo:type-check",
    "server": "cargo run -p genetic-assembly-server",
    "client:install": "npm --prefix client install",
    "client:build": "npm --prefix client run build",
    "client:type-check": "npm --prefix client run type-check",
    "headless:install": "npm --prefix headless-client install",
    "headless:build": "npm --prefix headless-client run build",
    "headless:type-check": "npm --prefix headless-client run type-check",
    "adapter-sdk:install": "npm --prefix adapter-sdk install",
    "adapter-sdk:build": "npm --prefix adapter-sdk run build",
    "adapter-sdk:test": "npm --prefix adapter-sdk test",
    "cli:install": "npm --prefix cli install",
    "cli:build": "npm --prefix cli run build",
    "reference:install": "npm --prefix examples/reference-adapter install",
    "reference:build": "npm --prefix examples/reference-adapter run build",
    "reference:test": "npm --prefix examples/reference-adapter test",
    "test:companion": "node scripts/test-companion.mjs",
    "viz:install": "npm --prefix visualizations install",
    "viz:build": "npm --prefix visualizations run build",
    "viz:type-check": "npm --prefix visualizations run type-check",
    "viz:test": "npm --prefix visualizations test",
    "demo:install": "npm --prefix demo install",
    "demo:dev": "npm --prefix demo run dev",
    "demo:build": "npm --prefix demo run build",
    "demo:type-check": "npm --prefix demo run type-check",
    "demo:preview": "npm --prefix demo run preview"
  },
  "keywords": [
    "rust",
    "genetic-algorithm",
    "nsga2",
    "threejs",
    "multi-objective-optimization"
  ],
  "author": "nikodellic",
  "license": "MIT"
}
